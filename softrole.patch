+# ---- the update -------------------------------------------------------------------------
+def rollout(policy, steps=6, n_p=2, n_a=1, seed=0):
+    net = policy.model
+    obs, kappa, pos = team(n_p, n_a, seed)
+    n = n_p + n_a
+    active = torch.ones(n, dtype=torch.bool)
+    g = build_role_graph(pos, active.numpy())
+    mem = net.init_memory(n)
+    policy.begin_episode(kappa[:, 1] > 0)
+    for t in range(steps):
+        out = net(obs, kappa, mem, active, g, DIM)
+        d = Categorical(logits=out['logits'])
+        a = d.sample()
+        policy.record(d.log_prob(a), out['value'], out['kl'], np.full(n, -0.05), active)
+        mem = dict(out['memory'], a_prev=a)
+
+
+def test_critic_gradient_never_reaches_role_parameters_and_storage_is_stable():
+    net = make_net()
+    policy = SoftRolePolicy(net, beta=0.1)
+    policy.c_pi = 0.0                                                # only the critic loss remains
+    rollout(policy)
+    policy.finish_batch()
+    role = {id(p) for p in net.role_parameters()}
+    assert all(torch.count_nonzero(p.grad) == 0 for p in net.parameters() if id(p) in role)
+    assert torch.count_nonzero(net.critic[0].weight.grad) > 0
+    assert torch.count_nonzero(net.lstm.weight_hh.grad) > 0
+    pointers = [p.grad.data_ptr() for p in net.parameters()]
+    policy.c_pi = 50.0
+    rollout(policy, seed=1)
+    policy.finish_batch()
+    assert pointers == [p.grad.data_ptr() for p in net.parameters()]  # accumulated in place
+    assert any(torch.count_nonzero(p.grad) > 0 for p in net.role_parameters())
+
