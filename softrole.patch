--- /dev/null
+++ b/softrole/net.py
@@ -0,0 +1,123 @@
+"""SoftRoleNet (replaces hetgat.uavnet.UAVNetA2CEasy)."""
+import math
+
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+
+from softrole.layers import RoleGATLayer
+
+STAY, CAPTURE = 4, 5
+ROLE_MODES = ('stochastic', 'deterministic', 'constant', 'capability')
+
+
+def kappa_index(kappa):
+    """Index of a capability vector [sense, cap] in {0, 1}^2 for the eta table."""
+    return (kappa[:, 0] + 2 * kappa[:, 1]).long()
+
+
+class SoftRoleNet(nn.Module):
+    def __init__(self, n_squares, base, n_channels=4, n_actions=6, d_pre=128, d_h=64,
+                 K=4, d_role=3, heads=4, d_head=16, n_bits=16, d_sen=16, d_critic=32,
+                 var_floor=0.01, lambda_rho=0.9, role_mode='stochastic', temperature=1.0):
+        super().__init__()
+        assert role_mode in ROLE_MODES
+        self.S, self.B, self.C = n_squares, base, n_channels
+        self.n_actions, self.d_h, self.d_head, self.d_role = n_actions, d_h, d_head, d_role
+        self.var_floor, self.lambda_rho, self.role_mode = var_floor, lambda_rho, role_mode
+        d_obs = n_squares * (base + n_channels) + 1
+        self.pre = nn.Linear(d_obs, d_pre)
+        self.lstm = nn.LSTMCell(d_pre + 2 + d_head + n_actions, d_h)
+        # Role parameters: the only parameters the critic's gradient is kept off.
+        self.role_enc = nn.Sequential(nn.Linear(d_h + 2, 32), nn.ReLU(), nn.Linear(32, 2 * d_role))
+        self.gate = nn.Linear(d_role, K)                   # g = softmax(G rho + g0)
+        self.eta = nn.Embedding(4, d_role)                 # prior default role per capability vector
+        nn.init.zeros_(self.eta.weight)
+        self.rounds = nn.ModuleList([
+            RoleGATLayer(d_h, d_head, heads, K, n_bits, 'cat', d_sen_in=4, d_sen_head=d_sen,
+                         d_role=d_role, temperature=temperature),
+            RoleGATLayer(heads * d_head, d_head, heads, K, n_bits, 'avg', d_sen_in=heads * d_sen,
+                         d_sen_head=d_sen, d_role=d_role, temperature=temperature)])
+        self.policy_head = nn.Linear(d_head, n_actions)    # shared over agents, then masked
+        self.critic = nn.Sequential(nn.Linear(d_sen + d_role + 2, d_critic), nn.ReLU(), nn.Linear(d_critic, 1))
+
+    # ---- bookkeeping -------------------------------------------------------------
+    def role_parameters(self):
+        return list(self.role_enc.parameters()) + list(self.gate.parameters())
+
+    def init_memory(self, n):
+        """Zero state for n rostered agents: H = C = u_bar = 0, previous action 'stay'."""
+        z = lambda d: torch.zeros(n, d)
+        return {'H': z(self.d_h), 'C': z(self.d_h), 'u_bar': z(self.d_head),
+                'a_prev': torch.full((n,), STAY, dtype=torch.long), 'rho_prev': z(self.d_role),
+                'kappa_prev': torch.zeros(n, 2), 'alive_prev': torch.zeros(n, dtype=torch.bool)}
+
+    @staticmethod
+    def detach_memory(mem):
+        """Truncated BPTT boundary: cut H, C, u_bar and the prior's rho_{t-1} together."""
+        return {k: (v.detach() if torch.is_tensor(v) and v.is_floating_point() else v) for k, v in mem.items()}
+
+    def encode_obs(self, obs, kappa):
+        """x = [cell-index one-hots ; channels * sense ; sense]. The env marks blind
+        agents with a -1 fill; multiplying by the sense flag maps that to 0 and the
+        trailing flag keeps 'no sensor' distinct from 'nothing seen'."""
+        n = obs.shape[0]
+        cells = obs.view(n, self.S, self.B + self.C)
+        sense = kappa[:, :1]
+        loc, ch = cells[..., :self.B], cells[..., self.B:] * sense[:, :, None]
+        return torch.cat([loc.flatten(1), ch.flatten(1), sense], dim=1)
+
+    # ---- one environment step ----------------------------------------------------
+    def forward(self, obs, kappa, mem, active, g, grid_side, noise=None, comm_off=False, rho_override=None):
+        noise = noise or {}
+        act = active.to(obs.dtype)[:, None]
+        x = F.relu(self.pre(self.encode_obs(obs, kappa)))
+        inp = torch.cat([x, kappa, mem['u_bar'], F.one_hot(mem['a_prev'], self.n_actions).to(obs.dtype)], 1)
+        H, C = self.lstm(inp, (mem['H'], mem['C']))
+        H, C = H * act, C * act                                     # agents not in N_t keep zero state
+
+        # Role: q(rho | H, kappa) = N(mu, diag sigma^2), one reparameterized sample per step.
+        role_in = torch.cat([H if self.role_mode != 'capability' else torch.zeros_like(H), kappa], 1)
+        mu, s = self.role_enc(role_in).chunk(2, dim=-1)
+        var = self.var_floor + F.softplus(s)
+        eps = noise.get('eps', torch.randn_like(mu))
+        if self.role_mode == 'stochastic':
+            rho = mu + var.sqrt() * eps
+        elif self.role_mode == 'constant':
+            rho = torch.zeros_like(mu)                              # shared weights + kappa baseline
+        else:
+            rho = mu                                                # deterministic / capability-only
+        if rho_override is not None:                                # interventions: freeze or pin
+            rho = torch.where(rho_override['mask'][:, None], rho_override['rho'], rho)
+        gate = torch.softmax(self.gate(rho), dim=-1)
+
+        # Persistence prior p(rho_t | rho_{t-1}, kappa_t); lambda = 0 on spawn or capability change.
+        same = mem['alive_prev'] & (kappa == mem['kappa_prev']).all(1)
+        lam = torch.where(same, torch.full_like(mu[:, 0], self.lambda_rho), torch.zeros_like(mu[:, 0]))[:, None]
+        prior_mean = lam * mem['rho_prev'] + (1 - lam) * self.eta(kappa_index(kappa))
+        prior_var = 1 - lam ** 2
+        kl = 0.5 * ((var + (mu - prior_mean) ** 2) / prior_var - 1 + torch.log(prior_var / var)).sum(-1)
+        if self.role_mode != 'stochastic':
+            kl = torch.zeros_like(kl)
+
+        # Communication rounds; the SEN reads each round's input features (training only).
+        n_act = active.sum().to(obs.dtype)
+        hs = torch.stack([n_act, (kappa[:, 0] * act[:, 0]).sum(), (kappa[:, 1] * act[:, 0]).sum(),
+                          torch.tensor(float(grid_side), dtype=obs.dtype)])[None]
+        h, bits, a_null = H, [], []
+        for l, layer in enumerate(self.rounds):
+            hs = layer.forward_sen(g, h, hs, rho, kappa)
+            h, b, an, _ = layer(g, h, gate, nu=noise.get(f'nu{l}'), comm_off=comm_off)
+            bits.append(b)
+            a_null.append(an)
+
+        logits = self.policy_head(h)
+        logits = logits.masked_fill((kappa[:, 1] == 0)[:, None] & (torch.arange(self.n_actions) == CAPTURE)[None],
+                                    float('-inf'))                  # log 1[a in A(kappa)]
+        value = self.critic(torch.cat([hs.expand(obs.shape[0], -1), rho.detach(), kappa], 1)).squeeze(-1)
+
+        new_mem = {'H': H, 'C': C, 'u_bar': h * act, 'a_prev': mem['a_prev'], 'rho_prev': rho,
+                   'kappa_prev': kappa.clone(), 'alive_prev': active.clone()}
+        diag = {'rho': rho.detach(), 'mu': mu.detach(), 'var': var.detach(), 'gate': gate.detach(),
+                'bits': [b.detach() for b in bits], 'alpha_null': a_null}
+        return {'logits': logits, 'value': value, 'kl': kl, 'memory': new_mem, 'diag': diag}
