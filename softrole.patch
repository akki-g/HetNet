+def tie_experts(net):
+    with torch.no_grad():
+        for m in net.modules():
+            if isinstance(m, (Bank, HeadBank)):
+                m.weight[:] = m.weight[:1].clone()
+                m.bias[:] = m.bias[:1].clone()
+        for layer in net.rounds:
