+def test_hetnet_gumbel_binarizer_is_the_same_channel():
+    """HetNet: gumbel_softmax(Linear(1,2)(z), hard=True) @ [0,1]. With the same Gumbel draws it
+    equals 1[k z + k0 + nu > 0] with k = w1 - w0, k0 = b1 - b0, nu = G1 - G0 ~ Logistic,
+    and its straight-through gradient equals d/dz sigmoid(k z + k0 + nu)."""
+    torch.manual_seed(3)
+    binarize = nn.Linear(1, 2)
+    z = torch.randn(64, 16, requires_grad=True)
+    torch.manual_seed(11)
+    hetnet = F.gumbel_softmax(binarize(z.unsqueeze(-1)), tau=1, hard=True) @ torch.tensor([0.0, 1.0])
+    (g_h,) = torch.autograd.grad(hetnet.sum(), z)
+    torch.manual_seed(11)                                     # replay the same Gumbel draws
+    gumbels = -torch.empty(64, 16, 2).exponential_().log()
+    k = binarize.weight[1, 0] - binarize.weight[0, 0]
+    k0 = binarize.bias[1] - binarize.bias[0]
+    ours = straight_through_bits(k * z + k0, gumbels[..., 1] - gumbels[..., 0])
+    (g_o,) = torch.autograd.grad(ours.sum(), z)
+    assert torch.equal(ours.detach(), (k * z + k0 + gumbels[..., 1] - gumbels[..., 0] > 0).double())
+    assert torch.equal(hetnet.detach(), ours.detach())
+    assert torch.allclose(g_h, g_o, atol=1e-12)
+
