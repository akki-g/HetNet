@@ -0,0 +1,85 @@
+"""SoftRoleTrainer: HetNet's Trainer with the rollout and the update replaced.
+
+run_batch, train_batch (grad /= num_steps, RMSprop step) and MultiProcessTrainer
+are inherited unchanged, so the optimizer pipeline is identical to the baseline.
+"""
+import numpy as np
+import torch
+from torch.distributions import Categorical
+
+from trainer import Trainer, Transition
+from utils import merge_stat
+from softrole import env as sr_env
+from softrole.graph import build_role_graph
+
+
+class SoftRoleTrainer(Trainer):
+    def __init__(self, args, policy_net, env, policy):
+        super().__init__(args, policy_net, env, policy)
+        self.n_max = args.sr_p_range[1] + args.sr_a_range[1]
+
+    def _event(self, t, kappa, n_p):
+        """Phase-4 event: one predator loses its sensor at step sr_sensor_loss_step."""
+        if self.args.sr_sensor_loss_step >= 0 and t == self.args.sr_sensor_loss_step and n_p > 0:
+            kappa = kappa.copy()
+            kappa[np.random.randint(n_p), 0] = 0.0      # global stream: per-worker seed
+        return kappa
+
+    def get_episode(self, epoch):
+        args, model, env = self.args, self.policy.model, sr_env.raw_env(self.env)
+        n_p, n_a = sr_env.sample_composition(args.sr_p_range, args.sr_a_range)
+        sr_env.set_composition(env, n_p, n_a)
+        state = self.env.reset(epoch)
+        n = n_p + n_a
+        kappa = sr_env.capabilities(env)
+        n_sq, base = (2 * args.vision + 1) ** 2, args.dim ** 2
+        active = torch.ones(n, dtype=torch.bool)
+        mem = model.init_memory(n)
+        self.policy.begin_episode(kappa[:, 1] > 0)
+        episode, stat = [], {}
+        diag_sum = {'sr_gate_entropy': 0.0, 'sr_alpha_null': 0.0, 'sr_rate': 0.0, 'sr_bits': 0.0}
+        for t in range(args.max_steps):
+            kappa = self._event(t, kappa, n_p)
+            obs = sr_env.apply_sensor_mask(state[0].numpy(), kappa, base, n_sq)
+            g = build_role_graph(sr_env.positions(env), active.numpy(), args.sr_comm_range)
+            out = model(torch.as_tensor(obs), torch.as_tensor(kappa), mem, active, g, grid_side=args.dim)
+            dist = Categorical(logits=out['logits'])
+            a = dist.sample()
+            next_state, reward, done, info = self.env.step([a.numpy()])
+            self.policy.record(dist.log_prob(a), out['value'], out['kl'], reward, active)
+
+            mem = out['memory']
+            mem['a_prev'] = a
+            if (t + 1) % args.detach_gap == 0:
+                mem = model.detach_memory(mem)
+
+            gate = out['diag']['gate']
+            diag_sum['sr_gate_entropy'] += float(-(gate * gate.clamp_min(1e-12).log()).sum())
+            for c in range(gate.shape[1]):     # expert load E[g_c]; collapse = one load near 1
+                diag_sum[f'sr_load_{c}'] = diag_sum.get(f'sr_load_{c}', 0.0) + float(gate[:, c].sum())
+            a_null = out['diag']['alpha_null']
+            diag_sum['sr_alpha_null'] += float(sum(x.sum() for x in a_null)) / len(a_null)  # mean over rounds
+            diag_sum['sr_rate'] += float(out['kl'].detach().sum())
+            diag_sum['sr_bits'] += float(sum(b.shape[1] for b in out['diag']['bits']) * int(active.sum()))  # L n |N_t|
+            padded = np.zeros(self.n_max)
+            padded[:n] = reward
+            stat['reward'] = stat.get('reward', 0) + padded
+            done = done or t == args.max_steps - 1
+            episode.append(Transition(state, a, None, None, None, None, next_state, reward, {}))
+            state = next_state
+            if done:
+                break
+        stat['num_steps'] = stat['steps_taken'] = t + 1
+        for k, v in diag_sum.items():          # per agent-step, except bits: per step for the team
+            stat[k] = v / (t + 1) if k == 'sr_bits' else v / ((t + 1) * n)
+        ep_return = np.asarray(stat['reward'][:n])
+        cap = kappa[:, 1] > 0
+        for flag, name in ((False, 'sr_return_nocap'), (True, 'sr_return_cap')):
+            stat[name] = float(ep_return[cap == flag].mean()) if (cap == flag).any() else 0.0
+        stat['sr_team_size'] = float(n)
+        merge_stat(self.env.get_stat(), stat)
+        return episode, stat
+
+    def compute_grad(self, batch):
+        loss = self.policy.finish_batch()
+        return {'action_loss': loss['policy'], 'value_loss': loss['critic'], 'rate_loss': loss['rate']}
