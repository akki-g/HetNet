+# ---- the role prior and the rate ------------------------------------------------------
+@pytest.mark.parametrize('persist', [False, True])
+def test_model_kl_matches_monte_carlo(persist):
+    """The rate the model returns equals E_q[log q - log p] under its own prior (lambda = 0 or 0.9)."""
+    net = make_net(lambda_rho=0.9)
+    with torch.no_grad():
+        net.eta.weight.normal_()                                 # non-zero defaults per kappa
+    obs, kappa, pos = team(2, 1)
+    n = 3
+    mem = net.init_memory(n)
+    rho_prev = torch.randn(n, 3)
+    if persist:
+        mem.update(alive_prev=torch.ones(n, dtype=torch.bool), kappa_prev=kappa.clone(), rho_prev=rho_prev)
+    out = net(obs, kappa, mem, torch.ones(n, dtype=torch.bool), build_role_graph(pos, np.ones(n, bool)), DIM,
+              noise=noise(net, n))
+    lam = 0.9 if persist else 0.0
+    m = lam * rho_prev + (1 - lam) * net.eta(torch.tensor([1, 1, 2])).detach()   # (1,0),(1,0),(0,1)
+    q = torch.distributions.Normal(out['diag']['mu'], out['diag']['var'].sqrt())
+    p = torch.distributions.Normal(m, math.sqrt(1 - lam ** 2))
+    x = q.sample((200_000,))
+    mc = (q.log_prob(x) - p.log_prob(x)).sum(-1)                 # (draws, n)
+    se = mc.std(0) / math.sqrt(mc.shape[0])
+    assert torch.all((mc.mean(0) - out['kl'].detach()).abs() < 4 * se)
+
