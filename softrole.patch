+def test_prior_resets_when_capability_changes():
+    net = make_net(lambda_rho=0.9)
+    with torch.no_grad():
+        net.eta.weight.normal_()
+    obs, kappa, pos = team(2, 1)
+    n = 3
+    g = build_role_graph(pos, np.ones(n, bool))
+    mem = net.init_memory(n)
+    mem.update(alive_prev=torch.ones(n, dtype=torch.bool), kappa_prev=kappa.clone(), rho_prev=torch.full((n, 3), 5.0))
+    k2 = kappa.clone()
+    k2[0, 0] = 0.0                                                   # predator 0 loses its sensor
+    out = net(obs, k2, mem, torch.ones(n, dtype=torch.bool), g, DIM, noise=noise(net, n))
+    mu, var = out['diag']['mu'], out['diag']['var']
+    eta = net.eta(torch.tensor([0, 1, 2]))                            # kappa indices (0,0),(1,0),(0,1)
+    reset = 0.5 * (var + (mu - eta) ** 2 - 1 - torch.log(var)).sum(-1)
+    assert torch.allclose(out['kl'][0], reset[0])                    # lambda = 0: prior N(eta(kappa), I)
+    assert not torch.allclose(out['kl'][1], reset[1])                # unchanged agents keep lambda_rho
+
