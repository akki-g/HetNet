+"""Run the fork's multiprocess gradient-contract probe on SoftRole instead of HetNet.
+
+Reuses hetnet_gradient_probe.run unchanged; only the policy factory and the
+observed trainer's base class are swapped. Same gates: shared weights, fresh
+gradient sum / num_steps, stable gradient storage.
+"""
+import argparse
+import json
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT))
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+
+import hetnet_gradient_probe as probe
+from softrole.args import add_softrole_args, resolve_softrole_args
+from softrole.policy import SoftRolePolicy
+from softrole.trainer import SoftRoleTrainer
+
+_make_args = probe.make_args
+
+
+def make_args(seed, batch_size, horizon, num_p, num_a):
+    config = _make_args(seed, batch_size, horizon, num_p, num_a)
+    defaults = add_softrole_args(argparse.ArgumentParser()).parse_args([])
+    for key, value in vars(defaults).items():
+        setattr(config, key, value)
+    config.softrole, config.msg_dim, config.sr_beta = True, 16, 0.01
+    return resolve_softrole_args(config)
+
+
+class ObservedSoftRoleTrainer(probe.ObservedTrainer, SoftRoleTrainer):
+    """MRO: instrumentation -> SoftRoleTrainer -> Trainer. No learner code is replaced."""
+
+
+probe.make_args = make_args
+probe.make_policy = SoftRolePolicy.from_args
+probe.ObservedTrainer = ObservedSoftRoleTrainer
+probe.SOURCES = probe.SOURCES + ["softrole/net.py", "softrole/layers.py", "softrole/policy.py", "softrole/trainer.py"]
+
+if __name__ == "__main__":
+    probe.main()
