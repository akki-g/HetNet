@@ -0,0 +1,5 @@
+"""SoftRole-HetNet: capability-aware learned roles on HetNet's binary channel.
+
+Additive package. Nothing in hetgat/ is modified, so the HetNet baseline path
+stays bit-identical. Enabled from main.py with --softrole.
+"""
diff --git a/softrole/args.py b/softrole/args.py
new file mode 100644
index 0000000..7fb4540
--- /dev/null
+++ b/softrole/args.py
@@ -0,0 +1,32 @@
+"""--softrole flags. Registered on main.py's parser; HetNet runs ignore them."""
+
+
+def add_softrole_args(parser):
+    sr = parser.add_argument_group('SoftRole-HetNet')
+    sr.add_argument('--softrole', action='store_true', default=False, help='train SoftRole-HetNet instead of HetNet')
+    sr.add_argument('--sr_role', default='stochastic',
+                    choices=['stochastic', 'deterministic', 'constant', 'capability'],
+                    help='full model | direct conditioning g(H,kappa) | rho = 0 | g(kappa) only')
+    sr.add_argument('--sr_experts', type=int, default=4, help='K, weight sets per bank')
+    sr.add_argument('--sr_role_dim', type=int, default=3, help='role dimension, K - 1')
+    sr.add_argument('--sr_beta', type=float, default=0.0, help='beta, weight of the rate term')
+    sr.add_argument('--sr_lambda_rho', type=float, default=0.9, help='lambda_rho, prior persistence')
+    sr.add_argument('--sr_var_floor', type=float, default=0.01, help='sigma^2_min')
+    sr.add_argument('--sr_pre_dim', type=int, default=128, help='observation encoder width')
+    sr.add_argument('--sr_hid_dim', type=int, default=64, help='LSTM width')
+    sr.add_argument('--sr_comm_range', type=float, default=-1.0, help='Euclidean range; -1 = all pairs')
+    sr.add_argument('--sr_p_range', type=int, nargs=2, default=None, help='min max predators per episode')
+    sr.add_argument('--sr_a_range', type=int, nargs=2, default=None, help='min max capture agents per episode')
+    sr.add_argument('--sr_sensor_loss_step', type=int, default=-1, help='step at which one predator goes blind')
+    return parser
+
+
+def resolve_softrole_args(args):
+    """Default team ranges collapse to the fixed HetNet composition (phase 0)."""
+    if args.sr_p_range is None:
+        args.sr_p_range = [args.nfriendly_P, args.nfriendly_P]
+    if args.sr_a_range is None:
+        args.sr_a_range = [args.nfriendly_A, args.nfriendly_A]
+    assert args.sr_role_dim == args.sr_experts - 1, 'd_rho = K - 1 (softmax shift invariance)'
+    args.hetgat = args.hetgat_a2c = True      # reuse the HetNet run_batch / train_batch plumbing
+    return args
diff --git a/softrole/bank.py b/softrole/bank.py
new file mode 100644
index 0000000..238cac6
--- /dev/null
+++ b/softrole/bank.py
@@ -0,0 +1,38 @@
+"""A bank of K affine maps mixed by a gate on the simplex: W(g) = sum_c g_c W_c."""
+import torch
+import torch.nn as nn
+
+
+class Bank(nn.Module):
+    def __init__(self, K, d_in, d_out):
+        super().__init__()
+        self.weight = nn.Parameter(torch.empty(K, d_out, d_in))
+        self.bias = nn.Parameter(torch.zeros(K, d_out))
+        for c in range(K):
+            # Independent draws per expert. Identical experts give dL/dg_c equal for
+            # every c, and the softmax Jacobian maps that constant vector to zero.
+            nn.init.xavier_uniform_(self.weight[c])
+
+    def experts(self, x):
+        """Every expert's output: (N, d_in) -> (N, K, d_out)."""
+        return torch.einsum('ni,koi->nko', x, self.weight) + self.bias
+
+    def forward(self, x, g):
+        """Mix with each row's own gate: W(g_n) x_n + b(g_n). Mixing outputs equals
+        mixing weights for affine maps, so no per-agent matrix is ever built."""
+        return torch.einsum('nk,nko->no', g, self.experts(x))
+
+
+class HeadBank(nn.Module):
+    """K affine maps per attention head: input (E, H, d_in) -> experts (E, K, H, d_out)."""
+
+    def __init__(self, K, H, d_in, d_out):
+        super().__init__()
+        self.weight = nn.Parameter(torch.empty(K, H, d_out, d_in))
+        self.bias = nn.Parameter(torch.zeros(K, H, d_out))
+        for c in range(K):
+            for h in range(H):
+                nn.init.xavier_uniform_(self.weight[c, h])
+
+    def experts(self, x):
+        return torch.einsum('ehi,khoi->ekho', x, self.weight) + self.bias
diff --git a/softrole/env.py b/softrole/env.py
new file mode 100644
index 0000000..aed38c0
--- /dev/null
+++ b/softrole/env.py
@@ -0,0 +1,46 @@
+"""Environment helpers for SoftRole on predator-capture (PCP). The env class is untouched."""
+import numpy as np
+
+
+def raw_env(wrapper):
+    """GymWrapper -> gym wrappers -> PredatorCaptureEnv. Attributes must be SET on
+    the unwrapped env; setattr on a gym wrapper would not reach it."""
+    return wrapper.env.unwrapped
+
+
+def set_composition(env, n_p, n_a):
+    """Change team counts before reset(). Every attribute the env derives from the
+    counts at init is updated, including nfriendly_P, which _get_reward indexes with."""
+    env.npredator, env.npredator_capture = n_p, n_a
+    env.nfriendly_P, env.nfriendly_A = n_p, n_a
+    env.predator_capture_index = n_p
+    env.captured_prey_index = n_p + n_a
+
+
+def sample_composition(p_range, a_range):
+    """Uses numpy's global stream, which MultiProcessWorker.run re-seeds per worker
+    (seed + id + 1). A generator created in __init__ would be copied into every
+    worker, and all of them would draw the same team sequence."""
+    return (int(np.random.randint(p_range[0], p_range[1] + 1)),
+            int(np.random.randint(a_range[0], a_range[1] + 1)))
+
+
+def capabilities(env):
+    """kappa = [sense, cap]: predators (1, 0), capture agents (0, 1), since the env
+    makes capture agents blind (action_blind)."""
+    n_p, n_a = env.npredator, env.npredator_capture
+    return np.array([[1.0, 0.0]] * n_p + [[0.0, 1.0]] * n_a)
+
+
+def positions(env):
+    """True grid positions in agent order (predators, then capture agents)."""
+    return np.vstack([env.predator_loc, env.predator_capture_loc])
+
+
+def apply_sensor_mask(obs, kappa, base, n_squares, n_channels=4):
+    """Observation of an agent without a sensor: the env's own convention, a -1 fill
+    of the class channels. Applied to agents whose sense flag was switched off."""
+    obs = obs.copy()
+    cells = obs.reshape(obs.shape[0], n_squares, base + n_channels)
+    cells[kappa[:, 0] == 0, :, base:] = -1.0
+    return cells.reshape(obs.shape)
diff --git a/softrole/evaluate.py b/softrole/evaluate.py
new file mode 100644
index 0000000..bda58a3
--- /dev/null
+++ b/softrole/evaluate.py
@@ -0,0 +1,64 @@
+"""Frozen-policy evaluation with in-episode events and interventions (no parameter updates).
+
+interventions:
+  none         the trained model as is
+  freeze_role  from the event on, the affected agent's role is pinned to its value just
+               before the event (kappa, masks and memory still update)
+  comm_off     alpha_null = 1 for every receiver, every step: no message reaches anyone
+  role_mean    rho = mu (no role noise)
+"""
+import numpy as np
+import torch
+from torch.distributions import Categorical
+
+from softrole import env as sr_env
+from softrole.graph import build_role_graph
+
+
+@torch.no_grad()
+def evaluate(model, gym_env, args, episodes, n_p, n_a, event_step=-1, intervention='none', seed=0):
+    rng = np.random.default_rng(seed)
+    raw = sr_env.raw_env(gym_env)
+    n_sq, base = (2 * args.vision + 1) ** 2, args.dim ** 2
+    results = []
+    for _ in range(episodes):
+        sr_env.set_composition(raw, n_p, n_a)
+        state = gym_env.reset(0)
+        n = n_p + n_a
+        kappa = sr_env.capabilities(raw)
+        active = torch.ones(n, dtype=torch.bool)
+        mem = model.init_memory(n)
+        victim = int(rng.integers(n_p)) if (event_step >= 0 and n_p > 0) else -1
+        pinned = None
+        success, steps = 0, args.max_steps
+        trace = {'kl': [], 'gate': [], 'alpha_null': []}     # per step, per agent
+        for t in range(args.max_steps):
+            if t == event_step and victim >= 0:
+                kappa = kappa.copy()
+                kappa[victim, 0] = 0.0
+                pinned = mem['rho_prev'][victim].clone()
+            override = None
+            if intervention == 'freeze_role' and pinned is not None:
+                mask = torch.zeros(n, dtype=torch.bool)
+                mask[victim] = True
+                override = {'mask': mask, 'rho': pinned.expand(n, -1)}
+            obs = sr_env.apply_sensor_mask(state[0].numpy(), kappa, base, n_sq)
+            g = build_role_graph(sr_env.positions(raw), active.numpy(), args.sr_comm_range)
+            eps = torch.zeros(n, model.d_role) if intervention == 'role_mean' else None
+            out = model(torch.as_tensor(obs), torch.as_tensor(kappa), mem, active, g, args.dim,
+                        noise={'eps': eps} if eps is not None else None,
+                        comm_off=(intervention == 'comm_off'), rho_override=override)
+            a = Categorical(logits=out['logits']).sample()
+            trace['kl'].append(out['kl'].tolist())
+            trace['gate'].append(out['diag']['gate'].tolist())
+            trace['alpha_null'].append(torch.stack(out['diag']['alpha_null']).mean(0).tolist())
+            state, reward, done, _ = gym_env.step([a.numpy()])
+            mem = dict(out['memory'], a_prev=a)
+            if done:
+                success, steps = 1, t + 1
+                break
+        results.append({'success': success, 'steps': steps, 'victim': victim, 'trace': trace,
+                        'steps_after_event': steps - event_step if (success and event_step >= 0) else None})
+    succ = np.array([r['success'] for r in results])
+    return {'success_rate': float(succ.mean()), 'episodes': episodes, 'intervention': intervention,
+            'mean_steps': float(np.mean([r['steps'] for r in results])), 'per_episode': results}
diff --git a/softrole/graph.py b/softrole/graph.py
new file mode 100644
index 0000000..e497d74
--- /dev/null
+++ b/softrole/graph.py
@@ -0,0 +1,39 @@
+"""Communication graph for SoftRole: one agent type, one relation, a null source, one SEN."""
+import dgl
+import numpy as np
+import torch
+
+
+def build_role_graph(pos, active, comm_range=-1.0):
+    """Build the per-step graph from TRUE positions (not decoded observations).
+
+    pos:        (N, 2) integer grid coordinates of every rostered agent.
+    active:     (N,) bool, the members of N_t. Inactive agents get no edges.
+    comm_range: Euclidean range; -1 means fully connected (HetNet's default).
+
+    Node type 'agent' has N + 1 nodes. Node N is the NULL SOURCE: it has one
+    edge into every active agent, carries a zero message and a learned score,
+    and is never a receiver. Edges run sender k -> receiver j.
+    """
+    pos = np.asarray(pos, dtype=np.float64)
+    active = np.asarray(active, dtype=bool)
+    n = len(pos)
+    members = np.flatnonzero(active)
+    src, dst = [], []
+    for j in members:
+        for k in members:
+            if k == j:
+                continue
+            if comm_range < 0 or np.linalg.norm(pos[k] - pos[j]) <= comm_range:
+                src.append(k)
+                dst.append(j)
+    n_real = len(src)
+    src += [n] * len(members)           # null slot: one edge N -> j per active receiver
+    dst += members.tolist()
+    g = dgl.heterograph({
+        ('agent', 'comm', 'agent'): (torch.tensor(src, dtype=torch.int64), torch.tensor(dst, dtype=torch.int64)),
+        ('agent', 'a2s', 'state'): (torch.tensor(members, dtype=torch.int64),
+                                    torch.zeros(len(members), dtype=torch.int64)),
+    }, num_nodes_dict={'agent': n + 1, 'state': 1})
+    g.edges['comm'].data['null'] = torch.arange(len(src)) >= n_real
+    return g
diff --git a/softrole/layers.py b/softrole/layers.py
new file mode 100644
index 0000000..7dfec1a
--- /dev/null
+++ b/softrole/layers.py
@@ -0,0 +1,105 @@
+"""One SoftRole communication round (replaces hetgat.graph.fastbinary.HeteroGATLayerBinary)."""
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+from dgl.ops import copy_e_sum, edge_softmax
+
+from softrole.bank import Bank, HeadBank
+
+
+def logistic_noise(shape, like):
+    """nu ~ Logistic(0, 1) by inverse CDF: log U - log(1 - U)."""
+    u = torch.rand(shape, dtype=like.dtype, device=like.device).clamp(1e-12, 1 - 1e-12)
+    return torch.log(u) - torch.log1p(-u)
+
+
+def straight_through_bits(u, nu, temperature=1.0):
+    """b_r = 1[u_r + nu_r > 0], so P(b_r = 1) = sigmoid(u_r) exactly.
+    Backward uses d/du sigmoid((u + nu) / T), the relaxed sample's derivative."""
+    soft = torch.sigmoid((u + nu) / temperature)
+    hard = (u + nu > 0).to(u.dtype)
+    return hard + (soft - soft.detach())      # forward: exactly hard; backward: d soft / du
+
+
+class RoleGATLayer(nn.Module):
+    """Round l: self transform, n-bit channel, receiver decoding, GATv2 + null slot.
+
+    Banks and the gate that selects them:
+        self, enc              own gate (the sender's, for enc)
+        dec, att, a, null      receiver's gate
+    The state node (SEN) is updated from the same input features; nothing flows
+    from the SEN back into any agent.
+    """
+
+    def __init__(self, d_in, d_head, heads, K, n_bits, merge, d_sen_in, d_sen_head,
+                 d_role=3, d_kappa=2, negative_slope=0.2, temperature=1.0):
+        super().__init__()
+        assert merge in ('cat', 'avg')
+        self.H, self.d, self.K, self.n = heads, d_head, K, n_bits
+        self.merge, self.slope, self.T = merge, negative_slope, temperature
+        self.self_bank = Bank(K, d_in, heads * d_head)
+        self.enc = Bank(K, d_in, n_bits)
+        self.dec = Bank(K, n_bits, heads * d_head)
+        self.att = HeadBank(K, heads, 2 * d_head, d_head)
+        self.a = nn.Parameter(torch.empty(K, heads, d_head))
+        self.null = nn.Parameter(torch.zeros(K, heads))
+        gain = nn.init.calculate_gain('relu')
+        for c in range(K):
+            nn.init.xavier_normal_(self.a[c], gain=gain)
+        # State summary node (training only), HetNet's additive attention form.
+        self.sen_self = nn.Linear(d_sen_in, heads * d_sen_head)
+        self.sen_in = nn.Linear(d_in + d_role + d_kappa, heads * d_sen_head)
+        self.sen_src = nn.Parameter(torch.empty(1, heads, d_sen_head))
+        self.sen_dst = nn.Parameter(torch.empty(1, heads, d_sen_head))
+        nn.init.xavier_normal_(self.sen_src, gain=gain)
+        nn.init.xavier_normal_(self.sen_dst, gain=gain)
+        self.d_sen = d_sen_head
+
+    def forward(self, g, h, gate, nu=None, comm_off=False):
+        """g: role graph; h: (N, d_in) round input; gate: (N, K). Returns the agents'
+        round output, the bits sent, alpha_null per receiver, and the edge weights."""
+        N, H, d = h.shape[0], self.H, self.d
+        z = self.self_bank(h, gate).view(N, H, d)                   # own gate
+        u = self.enc(h, gate)                                        # sender's own gate
+        if nu is None:
+            nu = logistic_noise(u.shape, u)
+        b = straight_through_bits(u, nu, self.T)                     # (N, n) in {0, 1}
+
+        src, dst = g.edges(etype='comm')
+        is_null = g.edges['comm'].data['null']
+        real = (~is_null).to(h.dtype)[:, None, None]
+        gd = gate[dst]                                               # receiver's gate per edge
+        dec_all = self.dec.experts(b).view(N, self.K, H, d)          # every expert decodes every sender
+        m = torch.einsum('ek,ekhd->ehd', gd, dec_all[src.clamp(max=N - 1)]) * real
+
+        pre = torch.einsum('ek,ekhd->ehd', gd, self.att.experts(torch.cat([z[dst], m], dim=-1)))
+        a = torch.einsum('ek,khd->ehd', gd, self.a)
+        e = (a * F.leaky_relu(pre, self.slope)).sum(-1)              # GATv2 score (E, H)
+        e_null = torch.einsum('ek,kh->eh', gd, self.null)            # receiver-only null score
+        e = torch.where(is_null[:, None], e_null, e)
+        alpha = edge_softmax(g['comm'], e)                           # one softmax incl. the null slot
+        if comm_off:                                                 # intervention: alpha_null = 1
+            alpha = is_null[:, None].to(h.dtype).expand_as(alpha)
+        M = copy_e_sum(g['comm'], alpha[..., None] * m)[:N]          # null edges carry m = 0
+
+        out = z + M
+        if self.merge == 'cat':
+            out = F.relu(out).flatten(1)
+        else:
+            out = out.mean(1)                                        # last round: average heads, no ReLU
+        alpha_null = torch.zeros(N, H, dtype=h.dtype)
+        alpha_null[dst[is_null]] = alpha[is_null].detach()
+        return out, b, alpha_null.mean(1), alpha
+
+    def forward_sen(self, g, h, hs, rho, kappa):
+        """SEN update: hs <- ReLU(W_s hs + sum_j beta_sj W_2s [h_j; sg(rho_j); kappa_j])."""
+        N, H, d = h.shape[0], self.H, self.d_sen
+        x = torch.cat([h, rho.detach(), kappa], dim=-1)
+        w_in = self.sen_in(x).view(N, H, d)
+        w_s = self.sen_self(hs).view(1, H, d)
+        src, _ = g.edges(etype='a2s')
+        score = F.leaky_relu((w_in[src] * self.sen_src).sum(-1) + (w_s * self.sen_dst).sum(-1), self.slope)
+        beta = edge_softmax(g['a2s'], score)                         # softmax over active agents
+        agg = copy_e_sum(g['a2s'], beta[..., None] * w_in[src])      # (1, H, d)
+        out = F.relu(w_s + agg)
+        return out.flatten(1) if self.merge == 'cat' else out.mean(1)
