+# ---- the binary channel ------------------------------------------------------------
+def test_bits_are_bernoulli_of_sigmoid():
+    torch.manual_seed(0)
+    u = torch.tensor([-2.0, -0.5, 0.0, 0.7, 3.0])
+    draws = 200_000
+    nu = logistic_noise((draws, 5), u)
+    b = straight_through_bits(u.expand(draws, 5), nu)
+    assert set(torch.unique(b.detach()).tolist()) <= {0.0, 1.0}
+    p_hat, p = b.detach().mean(0), torch.sigmoid(u)
+    assert torch.all((p_hat - p).abs() < 4 * torch.sqrt(p * (1 - p) / draws))
+
