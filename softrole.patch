+"""SoftRolePolicy (replaces A2CPolicy.batch_finish_per_class for --softrole)."""
+import numpy as np
+import torch
+import torch.nn as nn
+
+from softrole.net import SoftRoleNet
+
+
+class SoftRolePolicy:
+    def __init__(self, model, gamma=1.0, lmbda=0.95, beta=0.0, c_pi=50.0, max_grad_norm=0.75, device='cpu'):
+        self.model = model
+        self.gamma, self.lmbda, self.beta, self.c_pi = gamma, lmbda, beta, c_pi
+        self.max_grad_norm, self.device = max_grad_norm, device
+        role = {id(p) for p in model.role_parameters()}
+        self.non_role_params = [p for p in model.parameters() if id(p) not in role]
+        self.episodes = []
+
+    @classmethod
+    def from_args(cls, args):
+        model = SoftRoleNet(n_squares=(2 * args.vision + 1) ** 2, base=args.dim ** 2,
+                            d_pre=args.sr_pre_dim, d_h=args.sr_hid_dim, K=args.sr_experts,
+                            d_role=args.sr_role_dim, n_bits=args.msg_dim, var_floor=args.sr_var_floor,
+                            lambda_rho=args.sr_lambda_rho, role_mode=args.sr_role)
+        return cls(model, gamma=args.gamma, beta=args.sr_beta)
+
+    # ---- rollout buffers ---------------------------------------------------------
+    def begin_episode(self, cap_flags):
+        self.episodes.append({'logp': [], 'value': [], 'kl': [], 'reward': [], 'active': [],
+                              'cap': torch.as_tensor(cap_flags, dtype=torch.bool)})
+
+    def record(self, logp, value, kl, reward, active):
+        ep = self.episodes[-1]
+        ep['logp'].append(logp)
+        ep['value'].append(value)
+        ep['kl'].append(kl)
+        ep['reward'].append(torch.as_tensor(np.asarray(reward), dtype=value.dtype))
+        ep['active'].append(active.clone())
+
+    # ---- update ------------------------------------------------------------------
+    def gae(self, rewards, values):
+        """Per-agent GAE. The last recorded step bootstraps with 0, as in HetNet
+        (a truncation at max_steps is treated as terminal)."""
+        T = rewards.shape[0]
+        adv = torch.zeros_like(rewards)
+        running = torch.zeros_like(rewards[0])
+        for t in reversed(range(T)):
+            next_v = values[t + 1] if t + 1 < T else torch.zeros_like(values[t])
+            delta = rewards[t] + self.gamma * next_v - values[t]
+            running = delta + self.gamma * self.lmbda * running
+            adv[t] = running
+        return adv
+
+    def finish_batch(self):
+        E = len(self.episodes)
+        per_ep = []
+        for ep in self.episodes:
+            V = torch.stack(ep['value'])                              # (T, N)
+            A = self.gae(torch.stack(ep['reward']), V.detach())
+            per_ep.append((ep, V, A, A + V.detach(), torch.stack(ep['active'])))
+        # Normalize advantages within each capture-capability group, over valid entries only.
+        eps = np.finfo(np.float32).eps.item()
+        norm = {}
+        for flag in (False, True):
+            vals = torch.cat([A[m & (ep['cap'] == flag)[None]] for ep, _, A, _, m in per_ep])
+            norm[flag] = (vals.mean(), vals.std()) if vals.numel() > 1 else (0.0, 1.0)
+        l_pi = l_rate = l_v = 0.0
+        for ep, V, A, R, m in per_ep:
+            mean = torch.where(ep['cap'], torch.as_tensor(norm[True][0]), torch.as_tensor(norm[False][0]))
+            std = torch.where(ep['cap'], torch.as_tensor(norm[True][1]), torch.as_tensor(norm[False][1]))
+            A_n = (A - mean) / (std + eps)
+            mf = m.to(V.dtype)
+            l_pi = l_pi - (torch.stack(ep['logp']) * A_n * mf).sum()
+            l_rate = l_rate + (torch.stack(ep['kl']) * mf).sum()
+            l_v = l_v + (((V - R) ** 2 * mf).sum(0) / mf.sum(0).clamp(min=1)).sum()  # sum_j mean_t
+        l_pi, l_rate, l_v = l_pi / E, l_rate / E, l_v / E
+
+        for p in self.model.parameters():
+            # MultiProcessTrainer caches .grad storage by position after the first
+            # update, so every gradient is allocated once (spawned workers unpickle
+            # parameters without .grad) and afterwards only ever zeroed in place.
+            if p.grad is None:
+                p.grad = torch.zeros_like(p)
+            p.grad.zero_()
+        actor = self.c_pi * (l_pi + self.beta * l_rate)
+        actor.backward(retain_graph=True)
+        l_v.backward(inputs=self.non_role_params)                     # critic gradient kept off role params
+        nn.utils.clip_grad_norm_(self.model.parameters(), self.max_grad_norm)
+        self.episodes = []
+        n_agent_steps = float(sum(m.sum() for *_, m in per_ep))
+        return {'policy': float(l_pi), 'critic': float(l_v), 'rate': float(l_rate),
+                'rate_per_agent_step': float(l_rate) * E / max(n_agent_steps, 1.0)}
