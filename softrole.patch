@@ -0,0 +1,279 @@
+"""Unit tests for SoftRole-HetNet. Each test checks one property stated in the architecture guide."""
+import math
+
+import numpy as np
+import pytest
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+from torch.distributions import Categorical
+
+torch.set_default_dtype(torch.float64)
+
+from softrole.bank import Bank, HeadBank
+from softrole.graph import build_role_graph
+from softrole.layers import logistic_noise, straight_through_bits
+from softrole.net import CAPTURE, SoftRoleNet
+from softrole.policy import SoftRolePolicy
+
+DIM, VISION = 5, 2
+S, B = (2 * VISION + 1) ** 2, DIM ** 2
+
+
+def make_net(**kw):
+    torch.manual_seed(0)
+    return SoftRoleNet(n_squares=S, base=B, **kw)
+
+
+def team(n_p, n_a, seed=0):
+    rng = np.random.default_rng(seed)
+    n = n_p + n_a
+    obs = torch.as_tensor(rng.integers(0, 2, size=(n, S * (B + 4))).astype(float))
+    kappa = torch.tensor([[1.0, 0.0]] * n_p + [[0.0, 1.0]] * n_a)
+    pos = rng.integers(0, DIM, size=(n, 2))
+    return obs, kappa, pos
+
+
+def noise(net, n, seed=1):
+    gen = torch.Generator().manual_seed(seed)
+    out = {'eps': torch.randn(n, 3, generator=gen)}
+    for l, layer in enumerate(net.rounds):
+        u = torch.rand(n, layer.n, generator=gen)
+        out[f'nu{l}'] = torch.log(u) - torch.log1p(-u)
+    return out
+
+
+def step(net, obs, kappa, pos, rng_noise, comm_range=-1.0, **kw):
+    n = obs.shape[0]
+    active = torch.ones(n, dtype=torch.bool)
+    g = build_role_graph(pos, active.numpy(), comm_range)
+    return net(obs, kappa, net.init_memory(n), active, g, grid_side=DIM, noise=rng_noise, **kw)
