# Version runtime code, launchers, pinned dependencies and required assets.
/*
!/.gitignore
!/.python-version
!/LICENSE
!/*.py
!/pyproject.toml
!/requirements.txt
!/uv.lock
!/envs/
!/hetgat/
!/hetnet_ext/
!/publication_reconstruction/
!/scripts/
!/scripts_eval/
!/slurm/
!/softrole/
!/test_config/
# Required by slurm/softrole_capcon_readiness.sbatch (full pytest gate).
!/tests/

# Evidence transport is called by the Stokes readiness launcher.
!/analysis/
/analysis/*
!/analysis/capcom_programme_2026-10-12/
/analysis/capcom_programme_2026-10-12/*
!/analysis/capcom_programme_2026-10-12/integration/
/analysis/capcom_programme_2026-10-12/integration/*
!/analysis/capcom_programme_2026-10-12/integration/stage_evidence.py

# Generated files within the allowed source directories.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.DS_Store

# Local documentation, development tools and examples are not deployment inputs.
*.md
/envs/examples/
# Preserve legal notices and the exact inventory validated by ORIGINS.json.
!/envs/LICENSE.md
!/publication_reconstruction/runtime/envs/LICENSE.md
!/publication_reconstruction/runtime/envs/README.md

# Keep the graded pilot's deployment instructions beside its launcher.
!/softrole/GRADED_PILOT.md
