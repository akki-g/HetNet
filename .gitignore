# Version only the runnable project and its development files.
/*
!/.gitignore
!/.python-version
!/LICENSE
!/README.md
!/AGENTS.md
!/*.py
!/pyproject.toml
!/requirements.txt
!/uv.lock
!/envs/
!/hetgat/
!/hetnet_ext/
!/publication_reconstruction/
!/scripts/
!/scripts_eval/
!/slurm/
!/softrole/
!/test_config/
!/tests/

# Reusable verification tools; all other analysis stays private.
!/analysis/
/analysis/*
!/analysis/capcom_programme_2026-10-12/
/analysis/capcom_programme_2026-10-12/*
!/analysis/capcom_programme_2026-10-12/validate.py
!/analysis/capcom_programme_2026-10-12/validate_fixes.py
!/analysis/capcom_programme_2026-10-12/integration/
/analysis/capcom_programme_2026-10-12/integration/*
!/analysis/capcom_programme_2026-10-12/integration/stage_evidence.py

# Generated files within the allowed source directories.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.DS_Store
